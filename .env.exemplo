#Crie o arquivo .env com as chaves, ele não pode ser disponibilizado de forma pública

ANTHROPIC_API_KEY= #chave do Claude

GOOGLE_API_KEY= #chave do Google

# Banco de dados PostgreSQL (Heroku). Sem esta linha, o sistema usa o SQLite local.
# Formato: postgres://USUARIO:SENHA@HOST:5432/NOME_DO_BANCO
DATABASE_URL=

SECRET_KEY= #chave usada para assinar as sessões de login (qualquer texto longo e aleatório)
